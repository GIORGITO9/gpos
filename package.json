{
  "name": "gpos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "pos:print": "node scripts/pos-print.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "build:hostinger": "npm run db:generate && npm run build && SEED_DEMO=false npm run db:setup",
    "test": "tsx --test apps/api/test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "start": "npm run start -w apps/api",
    "test:integration": "RUN_INTEGRATION=true tsx --test apps/api/test/integration.test.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"scripts/*.ts\" \"prisma/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "dotenv": "16.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "concurrently": "9.2.5",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
